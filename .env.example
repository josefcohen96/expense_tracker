# Copy to .env and fill in real values. .env is gitignored — never commit secrets.
# In production (Railway) set these as service variables instead of using a file.

# Signs session and auth cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET_KEY=

# One variable per login, named USER_PASSWORD_<USERNAME>.
# A login fails loudly if its variable is missing — there are no defaults.
# Usernames are case-insensitive at the login form.
USER_PASSWORD_YOSEF=
USER_PASSWORD_KARINA=
# Tsahala only has access to the renovation module (/renovation).
USER_PASSWORD_TSAHALA=

# Comma-separated hosts accepted by the Host-header check.
# Add the production domain here; "*" is never safe.
ALLOWED_HOSTS=expensetracker-production-2084.up.railway.app,127.0.0.1,localhost
